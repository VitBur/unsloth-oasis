# Unsloth-served model (see oasis/models/unsloth.py)
# Base URL printed by `unsloth run` / Unsloth Studio. "/v1" is added if missing.
UNSLOTH_BASE_URL=http://localhost:8000
# API key printed by `unsloth run`, or created in Unsloth Studio > Settings > API.
UNSLOTH_API_KEY=sk-unsloth-replace-me
# Optional: pin a model id. When unset, the single loaded model is discovered.
# UNSLOTH_MODEL=unsloth/gemma-3-4b-it-GGUF:Q4_K_M
